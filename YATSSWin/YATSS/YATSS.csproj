<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>YATSSWin</AssemblyName>
    <TargetFramework>net10.0-windows7.0</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>0.20.0-beta.2</Version>
    <AssemblyVersion>0.20.0.0</AssemblyVersion>
    <FileVersion>0.20.0.0</FileVersion>
    <InformationalVersion>0.20.0-beta.2</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="SafeSerialPort.cs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.10" />
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.4" />
    <PackageReference Include="System.IO.Ports" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup>
    <Compile Update="Properties\Resources.Designer.cs">
      <DesignTime>True</DesignTime>
      <AutoGen>True</AutoGen>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\Sounds\lane-best.wav" LogicalName="YATSS.Assets.Sounds.lane-best.wav" />
    <EmbeddedResource Include="Assets\Sounds\heat-best.wav" LogicalName="YATSS.Assets.Sounds.heat-best.wav" />
    <Content Include="..\..\YATSSMC\dist\*.yatssfw">
      <Link>Firmware\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\tools\yatss-speech-helper.py">
      <Link>Linux\yatss-speech-helper.py</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\PIPER_SPEECH.md">
      <Link>Documentation\PIPER_SPEECH.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\docs\LINUX_SPEECH.md">
      <Link>Documentation\LINUX_SPEECH.md</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\tools\*-linux.sh">
      <Link>Linux\Build\%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
    <Content Include="..\..\YATSSUnoQ\**\*">
      <Link>Linux\UNOQ\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </Content>
  </ItemGroup>

  <Target Name="AddGitBuildDescription" BeforeTargets="GetAssemblyAttributes">
    <PropertyGroup>
      <GitBuildDescription>v$(Version)</GitBuildDescription>
    </PropertyGroup>
    <Exec
      Command="git describe --tags --always --long --dirty"
      ConsoleToMSBuild="true"
      IgnoreExitCode="true"
      StandardOutputImportance="Low"
      WorkingDirectory="$(MSBuildProjectDirectory)\..\.."
      Condition="Exists('$(MSBuildProjectDirectory)\..\..\.git')">
      <Output TaskParameter="ConsoleOutput" PropertyName="GitBuildDescription" />
    </Exec>
    <ItemGroup>
      <AssemblyMetadata Include="GitBuildDescription" Value="$(GitBuildDescription)" />
    </ItemGroup>
  </Target>

  <Target Name="RequireControllerFirmwarePackage" BeforeTargets="Publish">
    <ItemGroup>
      <_C6N4FirmwarePackage Include="..\..\YATSSMC\dist\YATSSMC-esp32-c6-devkitc1-n4-*.yatssfw" />
      <_C6N8FirmwarePackage Include="..\..\YATSSMC\dist\YATSSMC-esp32-c6-devkitc1-n8-*.yatssfw" />
      <_C5N16R8FirmwarePackage Include="..\..\YATSSMC\dist\YATSSMC-esp32-c5-waveshare-wifi6-n16r8-*.yatssfw" />
      <_NanoFirmwarePackage Include="..\..\YATSSMC\dist\YATSSMC-arduino-nano-esp32-*.yatssfw" />
    </ItemGroup>
    <Error
      Condition="'@(_C6N4FirmwarePackage)' == ''"
      Text="Build the C6/N4 controller firmware with tools\Build-ControllerFirmware.ps1 before publishing YATSS." />
    <Error
      Condition="'@(_C6N8FirmwarePackage)' == ''"
      Text="Build the C6/N8 controller firmware with tools\Build-ControllerFirmware.ps1 before publishing YATSS." />
    <Error
      Condition="'@(_C5N16R8FirmwarePackage)' == ''"
      Text="Build the Waveshare C5/N16R8 controller firmware with tools\Build-ControllerFirmware.ps1 before publishing YATSS." />
    <Error
      Condition="'@(_NanoFirmwarePackage)' == ''"
      Text="Build the Nano controller firmware with tools\Build-ControllerFirmware.ps1 before publishing YATSS." />
  </Target>

</Project>
